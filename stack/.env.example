# Copiá a .env y completá. El túnel NO usa token: su config y credenciales
# están en ./cloudflared/ (ver cloudflared/README.md).

# Imagen de la landing publicada por GitHub Actions en GHCR.
LANDING_IMAGE=ghcr.io/pel-matiasvaldivia/itier-landing:latest

# Hostname público. Creá vos el CNAME en Cloudflare apuntando al túnel
# (<TUNNEL_UUID>.cfargotunnel.com, proxied). Traefik rutea por este Host.
LANDING_HOST=demo.itier.pymesenlinea.com.ar
