# Copiá a .env y completá. El túnel ya existe (DW-Services) y su cloudflared ya
# corre en el VPS: este stack solo agrega Traefik + la landing.

# Imagen de la landing publicada por GitHub Actions en GHCR.
LANDING_IMAGE=ghcr.io/pel-matiasvaldivia/itier-landing:latest

# Hostname público. Debe ser IGUAL al Public Hostname que cargás en el túnel
# (dashboard) apuntando a http://itier-traefik:80. Traefik rutea por este Host.
LANDING_HOST=demo.itier.pymesenlinea.com.ar
