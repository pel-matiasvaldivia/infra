# Copiá a .env y completá. Si desplegás con Pulumi (deployToVps=true), este
# archivo lo genera Pulumi en el VPS y no hace falta crearlo a mano.

# Token del connector del túnel. Lo obtenés con:
#   cd ../pulumi && pulumi stack output tunnelTokenOut --show-secrets
TUNNEL_TOKEN=

# Imagen de la landing publicada por GitHub Actions en GHCR.
LANDING_IMAGE=ghcr.io/pel-matiasvaldivia/itier-landing:latest

# Hostname público. Debe coincidir con el ingress del túnel (config de Pulumi).
LANDING_HOST=demo.itier.pymesenlinea.com.ar
